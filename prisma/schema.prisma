generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  apiKey        String?
  accounts      Account[]
  sessions      Session[]
  typingSessions TypingSession[]
  keystrokeMistakes KeystrokeMistake[]
  reviewItems   ReviewItem[]
  dailyProgress DailyProgress[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TypingSession {
  id          String   @id @default(cuid())
  userId      String
  wpm         Float
  errorRate   Float
  content     String
  topic       String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KeystrokeMistake {
  id          String   @id @default(cuid())
  userId      String
  expectedChar String
  typedChar    String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReviewItem {
  id              String   @id @default(cuid())
  userId          String
  question        String
  answer          String
  hint            String?
  fillInBlank     String?
  nextReviewDate  DateTime @default(now())
  interval        Int      @default(1)
  easeFactor      Float    @default(2.5)
  repetitions     Int      @default(0)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyProgress {
  id        String   @id @default(cuid())
  userId    String
  dateStr   String   // Stored as "YYYY-MM-DD"
  words     Int      @default(0)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, dateStr])
}

